# Copy to .env (in the repo root). Every key is optional: the core demo runs without any of them.

# Gemini: words each learned step from before/after keyframes + the structured state change.
# It never decides pass/fail. https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ElevenLabs: spoken corrections. Falls back to the browser's speechSynthesis when absent or failing.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_flash_v2_5

# Opt-in beta: manual scans of 2-6 unique, separated objects. Color remains the default.
TEACHBACK_SEMANTIC_BETA=0
LOCATE_WSL_DISTRO=Ubuntu
LOCATE_MODEL=/home/authxd/models/locate-anything-q6_k.gguf
# Optional: override the isolated library produced by benchmarks/locate_anything/build_shared.py.
# LOCATE_LIBRARY=C:\AuthXD\hackumbc26\benchmarks\locate_anything\build\liblocate_anything.so

# Optional: Tiger Cloud (PostgreSQL) for Setup Check saved setups. Paste the service connection string from
# Tiger Cloud's connection details (postgres://user:password@host:port/tsdb?sslmode=require). It is a secret:
# keep it only in your local .env, which is git-ignored, and never commit it. TLS is always required. Leave it
# empty to keep saving setups as local JSON. After setting it, run `npm run tiger:check` once to create the table.
TIGER_DATABASE_URL=
