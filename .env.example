# Copy to .env (in the repo root). Every key is optional: the core demo runs without any of them.

# Gemini: names learned steps from before/after keyframes + the structured state change.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs: spoken corrections. Falls back to the browser's speechSynthesis when absent.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5
